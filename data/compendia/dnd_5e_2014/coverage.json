      ]
    },
    {
      "monster_id": "dnd_5e_2014:monster:werewolf",
      "notes": [
        {
          "source_ref": "dndsu:monster:werewolf",
          "note_ru": "Условный иммунитет к физическому урону сохранён в damage_immunities и требует немагической атаки без серебра; серебрение не потеряно."
        }
      ]
    },
