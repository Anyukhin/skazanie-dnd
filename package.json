{
  "name": "skazanie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "node tools/run-test-suite.mjs",
    "test:contract": "node test/kit/run-contract.mjs",
    "rust:play": "node tools/rust-play.mjs",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage",
    "verify": "pnpm test && pnpm build",
    "content:verify": "node tools/verify-content-integrity.mjs",
    "content:audit": "node tools/audit-content-presentation.mjs",
    "compendium:verify": "node tools/verify-dndsu-2014-content.mjs --repository-loader",
    "spells:verify": "node tools/verify-spell-overrides.mjs",
    "spells:acceptance": "node tools/verify-spell-overrides.mjs --acceptance",
    "release:verify": "node tools/verify-content-integrity.mjs --release",
    "backup": "node tools/storage-backup.mjs",
    "docker:up": "docker compose -f compose.rust.yaml up -d --build",
    "docker:down": "docker compose -f compose.rust.yaml down",
    "icons:manifest": "node tools/build-icon-manifest.mjs",
    "items:manifest": "node tools/build-item-manifest.mjs",
    "items:rights": "node tools/register-asset-rights.mjs --all-under items",
    "props:atlas": "node tools/build-prop-atlas.mjs",
    "props:rights": "node tools/register-asset-rights.mjs --all-under maps/props",
    "models:prepare": "node tools/environment-assets.mjs prepare",
    "models:check": "node tools/environment-assets.mjs check",
    "models:publish": "node tools/environment-assets.mjs publish",
    "enemies:portrait": "node tools/generate-enemy-portrait.mjs",
    "enemies:rights": "node tools/register-asset-rights.mjs --all-under enemies",
    "terrain:tiles": "node tools/build-terrain-tiles.mjs",
    "terrain:rights": "node tools/register-asset-rights.mjs --all-under maps/terrain",
    "talespire:assets": "node tools/build-talespire-asset-table.mjs",
    "maps:preview": "node tools/map-preview.mjs",
    "models:scale": "node tools/model-scale-audit.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2"
  }
}
