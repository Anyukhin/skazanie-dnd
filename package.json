{
  "name": "skazanie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 4173",
    "dev:agent": "node server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "node tools/run-test-suite.mjs",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "verify": "pnpm test && pnpm typecheck:server && pnpm build",
    "content:verify": "node tools/verify-content-integrity.mjs",
    "spells:verify": "node tools/verify-spell-overrides.mjs",
    "release:verify": "node tools/verify-content-integrity.mjs --release",
    "cutover:audit": "node tools/audit-cutover.mjs",
    "cutover:verify": "node tools/audit-cutover.mjs --strict",
    "backup": "node tools/storage-backup.mjs",
    "rules:verify": "node --test test/rule-pack.test.mjs test/rule-retriever.test.mjs",
    "migrate": "node server/migrations/run.mjs",
    "migrate:dry-run": "node server/migrations/run.mjs --dry-run",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "icons:manifest": "node tools/build-icon-manifest.mjs",
    "items:manifest": "node tools/build-item-manifest.mjs",
    "items:rights": "node tools/register-asset-rights.mjs --all-under items",
    "props:atlas": "node tools/build-prop-atlas.mjs",
    "props:rights": "node tools/register-asset-rights.mjs --all-under maps/props",
    "enemies:portrait": "node tools/generate-enemy-portrait.mjs",
    "enemies:rights": "node tools/register-asset-rights.mjs --all-under enemies",
    "terrain:tiles": "node tools/build-terrain-tiles.mjs",
    "terrain:rights": "node tools/register-asset-rights.mjs --all-under maps/terrain"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
