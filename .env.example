# Секрет хранится только на сервере. Не добавляйте .env в git.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Порядок выбран живым замером, docs/live-narrator-eval.md: при боевом
# таймауте DND_AI_MODEL_TIMEOUT_MS первичная модель обязана укладываться в
# него почти всегда, иначе каждый ход платит таймаут перед фолбэком.
DND_AI_MODEL=deepseek/deepseek-v4-flash
DND_AI_FALLBACK_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.2,qwen/qwen3.7-plus,google/gemini-2.5-flash-lite,openai/gpt-4.1-nano
DND_AI_MAX_TOKENS=1200
DND_AI_DAILY_TOKEN_LIMIT=2000000
DND_AI_MODEL_TIMEOUT_MS=20000
DND_AI_PROBE_TIMEOUT_MS=15000
DND_AI_FAILURE_COOLDOWN_MS=120000
# Серверный лимит хода в бою; после него EndTurn коммитится автоматически.
DND_COMBAT_TURN_TIMEOUT_MS=120000
# Сколько новых локаций за день считается поводом предупредить стол о расходе.
# Это НЕ лимит: генерация не блокируется, в летопись уходит одна строка.
DND_ARCHITECT_ALERT_THRESHOLD=3
# Перерыв в часах, после которого при входе показывается рекап «в прошлой
# серии». Ваншот за один вечер порога не достигает и рекапа не увидит.
DND_RECAP_GAP_HOURS=8
# Модель для иллюстраций предметов и важных NPC; ключ остаётся server-only.
DND_IMAGE_MODEL=openai/gpt-image-1
# Генерация картинок ВО ВРЕМЯ ИГРЫ. По умолчанию выключена (пустое значение или
# что угодно кроме on/true/1/yes): вечер стоит около 50 ₽, и платить за картинку
# посреди хода, пока стол ждёт, незачем. Выключенный флаг не мешает отдавать уже
# готовые картинки из кеша и не мешает режиму подготовки ассетов — тот работает
# всегда. Включать осознанно и понимая расход.
DND_RUNTIME_IMAGE_GENERATION=
# Единый server-authoritative игровой цикл. dnd_5e_2014 выбирается по кампании
# как partial preview, но пока не разрешён как process-wide default.
DND_DEFAULT_RULESET_ID=srd_5_2_1
DND_DEFAULT_RULESET_VERSION=5.2.1
# По умолчанию используется ./storage. В Docker значение задаётся compose.yaml.
DND_STORAGE_DIR=
# Ключ шифрования резервных копий storage (pnpm backup). Не меньше 32 байт.
# Хранить отдельно от копий: файл .skzbackup без этого же значения не
# расшифровывается и не восстанавливается — потеря ключа равна потере копии.
DND_BACKUP_KEY=
AGENT_PORT=8787
AGENT_HOST=0.0.0.0
# false сохраняет локальный вход по HTTP; через Pinggy флаг Secure добавляется автоматически.
COOKIE_SECURE=false

# Одноразовый код создаётся лаунчером автоматически и нужен только для первой учётной записи администратора.
ADMIN_SETUP_TOKEN=

# Публичная HTTPS-ссылка создаётся автоматически через Pinggy.
# Токен, домен и проброс входящего порта на роутере не требуются.

# Локальная диктовка: пути к whisper-cli и многоязычной модели ggml.
DND_WHISPER_EXECUTABLE=
DND_WHISPER_MODEL=
