# Секрет хранится только на сервере. Не добавляйте .env в git.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
DND_AI_MODEL=qwen/qwen3.7-plus
DND_AI_FALLBACK_MODELS=z-ai/glm-5.2,deepseek/deepseek-v4-flash,google/gemini-2.5-flash-lite,openai/gpt-4.1-nano
DND_AI_MAX_TOKENS=1200
DND_AI_DAILY_TOKEN_LIMIT=2000000
DND_AI_MODEL_TIMEOUT_MS=9000
DND_AI_PROBE_TIMEOUT_MS=15000
DND_AI_FAILURE_COOLDOWN_MS=120000
DND_IMAGE_MODEL=openai/gpt-image-1
# Единый server-authoritative игровой цикл.
DND_DEFAULT_RULESET_ID=srd_5_2_1
DND_DEFAULT_RULESET_VERSION=5.2.1
# По умолчанию используется ./storage. В Docker значение задаётся compose.yaml.
DND_STORAGE_DIR=
AGENT_PORT=8787
AGENT_HOST=0.0.0.0
# false сохраняет локальный вход по HTTP; через Pinggy флаг Secure добавляется автоматически.
COOKIE_SECURE=false

# Одноразовый код создаётся лаунчером автоматически и нужен только для первой учётной записи администратора.
ADMIN_SETUP_TOKEN=

# Публичная HTTPS-ссылка создаётся автоматически через Pinggy.
# Токен, домен и проброс входящего порта на роутере не требуются.
