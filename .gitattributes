# Содержимое public/assets учитывается по хешу в data/asset-rights.json, и
# проверка целостности сверяет и размер, и SHA-256. Перевод строк здесь трогать
# нельзя: git с core.autocrlf на выгрузке превратил бы LF в CRLF, размер файла
# изменился бы, и content-integrity упал бы на ровном месте.
public/assets/** -text

# data/ учитывается так же: content-provenance.json и
# character-rules-manifest.json сверяют точный размер и SHA-256, поэтому файлы
# выгружаются дословными байтами блобов на любой ОС. Манифесты пересобраны под
# эти байты коммитом нормализации 2026-07-28 (решение владельца): прежде
# объявленные размеры были сняты с рабочих файлов со смешанными переводами
# строк ДО того, как git нормализовал их при коммите, и не совпадали ни с
# каким вариантом выгрузки — целостность не сходилась ни на одной машине,
# кроме исходной.
data/** -text
