# Контрактные HTTP-тесты против бинаря Rust-сервера (rust/SERVER-PLAN.md, обозначение «К»).
#
# Каждая строка — путь к одному файлу test/*.test.mjs от корня репозитория.
# Пустые строки и строки с «#» пропускаются; комментарий в конце строки — тоже после «#».
#
# Вносить файл, когда:
#   1. он запускает сервер только через test/kit (startTestServer), без своего spawn
#      и без preload/args — кости и сбои передаются данными (dice, faults);
#   2. журнал он читает и портит только через readJournal / corruptCampaign /
#      appendJournal, а не файлами storage/engine;
#   3. маршруты, которые он трогает, уже перенесены в sk-server (задача С*), и
#      `pnpm test:contract:rust` с этим файлом зелёный.
#
# Тот же список гоняется и против JS-эталона: `pnpm test:contract:js` обязан
# оставаться зелёным. Убирать файл из списка ради зелёного Rust нельзя —
# расхождение чинится в Rust или фиксируется решением ведущего.

# С2 (2026-10-23): в Rust пока только вход, сессии и health — зелёные файлы целиком.
test/test-network-isolation.test.mjs  # запуск бинаря только набором и с изолированным окружением
test/storage-backup-cli.test.mjs      # отметка писателя storage у живого сервера (sk_infra::backup_service), остальное — CLI без сервера

# С4 (2026-10-23): служебные маршруты и справочники.
test/ruleset-activation-guard.test.mjs  # отказ старта с DND_DEFAULT_RULESET_ID=dnd_5e_2014
test/speech-input-api.test.mjs          # speech status и transcribe: права, WAV, 503/502, окно попыток

# С6 (2026-10-23): кампании, членство, рекап. creator-seat-api, ruleset-selection-api,
# table-of-five-api и api-integration проходят шаги С6, но дальше идут в /commands,
# /settings, /presence/typing и /narrate — вне списка до их задач.
test/world-template-api.test.mjs  # GET шаблонов и POST /api/campaigns с авторским миром, серверные поля шаблона
test/heroes-api.test.mjs          # GET /api/heroes: права, герои всех кампаний без повторов, порядок в русской локали

# С7 (2026-10-23): настройки ИИ, редакция, домашние правила. campaign-reasoning-settings,
# campaign-improv-mode и house-rule-default-api проходят все шаги /settings (с рестартом и
# правилами по умолчанию при старте), но проверяют летопись и state_version через
# GET /api/rooms (С10); ruleset-selection-api дальше идёт в /lifecycle (С8) — вне списка до них.
# С10 (2026-10-23): комната, общий кубик, выдача кости. narrate-room-version-race (PUT 410
# уже проходит), viewer-projection-api и roll-binding упираются в /api/narrate — вне списка до С18.
test/free-dice-api.test.mjs           # общий кубик: права, закрытый набор граней, проекция комнаты и SSE второму игроку
test/recovery-required-api.test.mjs   # испорченная кампания: GET /api/rooms отказывает, сервер и соседняя кампания живы
# С7+С10 (2026-10-23): с GET /api/rooms тесты настроек проходят целиком против Rust.
test/campaign-reasoning-settings.test.mjs   # уровень рассуждений: права, сохранение, перезапуск
test/campaign-improv-mode.test.mjs          # режим импровизации: строка летописи без события
test/house-rule-default-api.test.mjs        # домашние правила по умолчанию при старте

# С8 (2026-10-23): откат ведущего и жизненный цикл кампании.
test/campaign-controls-api.test.mjs    # /controls и /lifecycle: права владельца, ключ, event_id, повтор и конфликт, сводка финала, replay после restart
test/ruleset-selection-api.test.mjs    # редакция до первого игрового события; пауза через /lifecycle закрывает смену (С7 + С8)

# С11 (2026-10-23): решения отряда и задания. quest-abandonment-api проходит quests и votes,
# но дальше идёт в /api/narrate (С18.5) — вне списка до неё.
test/party-decision-roll-api.test.mjs  #общий бросок: серверная кость, права, повтор по ключу, закрытое решение, replay

# С18.5 (2026-10-23): POST /api/narrate, переходы сцены Режиссёра, соло-выход, живой поток рассказа.
# Остальные файлы группы (api-integration, command-retry-intent-api, director-shop-api, law-api,
# merchant-api, npc-world-consequences-api, parley-api, persistent-campaign-api, table-of-five-api,
# tavern-api, world-data-flow-api, mvp-player-cycle-api) упираются в /commands (С18.1), dialogue-api —
# в /autonomy/advance (С18.4); narrate-retry-recovery и tactical-command-recovery — клиентские, без сервера.
test/narration-stream-api.test.mjs       # SSE рассказа: изоляция, replay при переподключении, канонический финал
test/narrate-room-version-race.test.mjs  # room_version ответа перечитывается после хода; PUT комнаты — 410
test/party-interaction-api.test.mjs      # карточка голосования Режиссёра, голос вне своего хода
test/solo-party-exit-api.test.mjs        # соло-стол уходит без карточки, ID карты до Архитектора, отказ от задания
test/quest-abandonment-api.test.mjs      # отказ от задания голосованием и переход сцены, replay/restart
test/viewer-projection-api.test.mjs      # ответ хода и комната не раскрывают закрытую память мира
test/roll-binding.test.mjs               # проверку исполняет только кость своей карточки
test/roll-reservation-api.test.mjs       # резерв броска: несостоявшийся commit возвращает кость
test/nonstandard-action-api.test.mjs     # свободный трюк: check → roll → commit и replay после restart
test/action-sequence-roll-api.test.mjs   # план из шагов: бросок первого шага по HTTP

# С13 (2026-10-23): импорт и перестройка карт.
test/map-import-api.test.mjs  # тело не объект и граница 500; предпросмотр, применение, перестройка, повтор и конфликт ключа, права, обход через /commands (404 до С18 — тоже отказ)

