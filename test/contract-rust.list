# Контрактные HTTP-тесты против бинаря Rust-сервера (rust/SERVER-PLAN.md, обозначение «К»).
#
# Каждая строка — путь к одному файлу test/*.test.mjs от корня репозитория.
# Пустые строки и строки с «#» пропускаются; комментарий в конце строки — тоже после «#».
#
# Вносить файл, когда:
#   1. он запускает сервер только через test/kit (startTestServer), без своего spawn
#      и без preload/args — кости и сбои передаются данными (dice, faults);
#   2. журнал он читает и портит только через readJournal / corruptCampaign /
#      appendJournal, а не файлами storage/engine;
#   3. маршруты, которые он трогает, уже перенесены в sk-server (задача С*), и
#      `pnpm test:contract:rust` с этим файлом зелёный.
#
# Тот же список гоняется и против JS-эталона: `pnpm test:contract:js` обязан
# оставаться зелёным. Убирать файл из списка ради зелёного Rust нельзя —
# расхождение чинится в Rust или фиксируется решением ведущего.

# С2 (2026-10-23): в Rust пока только вход, сессии и health — зелёные файлы целиком.
test/test-network-isolation.test.mjs  # запуск бинаря только набором и с изолированным окружением
test/storage-backup-cli.test.mjs      # отметка писателя storage у живого сервера (sk_infra::backup_service), остальное — CLI без сервера

# С4 (2026-10-23): служебные маршруты и справочники.
test/ruleset-activation-guard.test.mjs  # отказ старта с DND_DEFAULT_RULESET_ID=dnd_5e_2014
test/speech-input-api.test.mjs          # speech status и transcribe: права, WAV, 503/502, окно попыток

# С6 (2026-10-23): кампании, членство, рекап. creator-seat-api, ruleset-selection-api,
# table-of-five-api и api-integration проходят шаги С6, но дальше идут в /commands,
# /settings, /presence/typing и /narrate — вне списка до их задач.
test/world-template-api.test.mjs  # GET шаблонов и POST /api/campaigns с авторским миром, серверные поля шаблона
test/heroes-api.test.mjs          # GET /api/heroes: права, герои всех кампаний без повторов, порядок в русской локали

# С7 (2026-10-23): настройки ИИ, редакция, домашние правила. campaign-reasoning-settings,
# campaign-improv-mode и house-rule-default-api проходят все шаги /settings (с рестартом и
# правилами по умолчанию при старте), но проверяют летопись и state_version через
# GET /api/rooms (С10); ruleset-selection-api дальше идёт в /lifecycle (С8) — вне списка до них.

# С8 (2026-10-23): откат ведущего и жизненный цикл кампании.
test/campaign-controls-api.test.mjs    # /controls и /lifecycle: права владельца, ключ, event_id, повтор и конфликт, сводка финала, replay после restart
test/ruleset-selection-api.test.mjs    # редакция до первого игрового события; пауза через /lifecycle закрывает смену (С7 + С8)
