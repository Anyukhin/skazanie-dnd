{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/asset-registry.mjs",
    "server/authored-location-maps.mjs",
    "server/backgrounds.mjs",
    "server/building-generator.mjs",
    "server/combat-bounds.mjs",
    "server/combat-forecast-view.mjs",
    "server/concentration-end-reasons.mjs",
    "server/contracts.mjs",
    "server/detail-props.mjs",
    "server/dynamic-map.mjs",
    "server/environment-catalog-revision.mjs",
    "server/graph-layout.mjs",
    "server/image-generation.mjs",
    "server/location-illustrations.mjs",
    "server/map-library.mjs",
    "server/map-quality.mjs",
    "server/map-store.mjs",
    "server/npc-portraits.mjs",
    "server/party-exit-intent.mjs",
    "server/prop-placement.mjs",
    "server/reaction-preferences.mjs",
    "server/reveal-delta.mjs",
    "server/reveal-transport.mjs",
    "server/room-floors.mjs",
    "server/routes/map-import-routes.mjs",
    "server/rules/actors.mjs",
    "server/rules/core.mjs",
    "server/scene-dressing.mjs",
    "server/scene-features.mjs",
    "server/scene-graph.mjs",
    "server/scene-program-layout.mjs",
    "server/scene-requirements.mjs",
    "server/scene-themes.mjs",
    "server/tactical-map.mjs",
    "server/talespire-import.mjs",
    "server/talespire-slab.mjs",
    "server/thin-walls.mjs",
    "server/viewer-projection.mjs",
    "server/world-ontology.mjs",
    "server/world-template-catalog.mjs"
  ]
}
